    "Main_Skills_Optimal_Attributes_Description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculate optimal attribute distribution based on current skill queue"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基于当前技能队列计算最优属性分配"
          }
        }
      }
    },
    "Main_Skills_Optimal_Attributes_Difference" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Difference"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "差值"
          }
        }
      }
    },
    "Main_Skills_Optimal_Attributes_Info" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Based on skills still to train, this shows how to split your 14 remappable points (each attribute starts at 17) for the shortest total training time.\n\nGreen +N means: after a remap, put N points into that attribute (base = 17 + N).\n\nExample: Perception +7 means your remapped base Perception should be 24 (17+7), not “add 7 to whatever your sheet shows now.” If your sheet already shows 24 or higher for Perception, that stat is likely already fine.\n\nAll 14 points must be spent, e.g. Perception +7, Memory +4, Willpower +3, others stay at 17. Implant bonuses are separate. If you use an attribute booster, time saved is estimated without the booster effect."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据待训练技能，计算怎样分配 14 个可分配点能最快练完。\n\n绿色 +N 的含义：建议把 N 点投入该属性，即基础值 = 17 + N。\n\n举例：列表显示「感知 +7」，表示感知基础值应为 24（17+7），而不是在你当前面板数值上再加 7。若你当前感知面板已是 24 或更高，说明这项分配已接近最优。\n\n14 点需全部分完，例如感知 +7、记忆 +4、意志 +3，其余两项保持 17。植入体加成不纳入计算；若使用属性加速器，「可节省时间」按无加速器口径估算。"
          }
        }
      }
    },
    "Main_Skills_Optimal_Attributes_Info_Title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About Optimal Attributes"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关于最优属性分配"
          }
        }
      }
    },
