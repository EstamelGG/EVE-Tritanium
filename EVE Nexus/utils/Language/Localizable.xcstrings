      }
    },
    "Notifications_SkillQueue_Info_Body" : {
      "comment" : "Skill queue notification info sheet body",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skill queue notifications are based on the data last fetched by this app.\n\nSince the app cannot refresh skill queue in the background and ESI has cache delays, if you adjust your skill queue in-game without re-fetching in this app, notification timing may be inaccurate."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "技能队列通知基于本应用最近一次刷新的数据生成。\n\n由于应用无后台刷新技能的能力，且 ESI 存在缓存延迟，若您在游戏内调整了技能队列但未在本应用中重新拉取，那么通知时间可能不准确。"
          }
        }
      }
    },
