    "PI_SiteFinder_Description_Text" : {
      "comment" : "功能描述",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find the best systems to produce a specific PI product. Select your target product, region, sovereignty, and jump range to get ranked recommendations.\n\n• Analyzes resource availability and planet types\n• Considers nearby systems for missing resources\n• Provides detailed scoring and resource coverage information"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找到生产特定PI产品的最佳星系。选择目标产品、星域、主权和跳跃范围，获得排名推荐。\n\n• 分析资源可用性和行星类型\n• 考虑邻近星系的缺失资源\n• 提供详细的评分和资源覆盖信息"
          }
