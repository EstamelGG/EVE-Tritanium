    "Account_Steam_Login_Description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We received an email from a user who found that they could not log in to their game account through Steam. \n\nWe verified this issue but have not yet found a suitable solution. \n\nThis issue mainly occurs on iOS user devices with the Steam App installed. If you have the same problem, you can take the following measures to mitigate it.\n\n"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы получили запрос от пользователя, который обнаружил, что не может авторизоваться через Steam.. \n\nМы проверили эту проблему, но пока не нашли подходящего решения. \n\nЭта проблема в основном возникает на устройствах пользователей iOS с установленным приложением Steam. Если у вас возникла такая же проблема, вы можете принять следующие меры для ее устранения.\n\n"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们收到一位用户的邮件，其发现无法通过Steam登录游戏账号。\n\n我们验证了此问题，但暂未找到合适的解决方案。\n\n此问题主要出现在安装了 Steam App 的 IOS 用户设备，如果您也有相同的问题，可以尝试采取以下措施进行缓解。\n\n"
          }
        }
      }
    },
    "Account_Steam_Login_GIF_Not_Found" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GIF image not found"
