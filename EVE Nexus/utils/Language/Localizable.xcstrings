    "PI_Output_Description_Text" : {
      "comment" : "功能描述",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculate what PI products can be produced in a selected system and its surrounding area. Choose a central system and jump range to see all available resources and production possibilities.\n\n• Shows P0-P4 resources available in the region\n• Considers resource dependencies and production chains\n• Helps plan efficient PI operations"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "计算在选定星系及其周边区域可以生产哪些PI产品。选择中心星系和跳跃范围，查看所有可用资源和生产可能性。\n\n• 显示区域内可用的P0-P4资源\n• 考虑资源依赖关系和生产链\n• 帮助规划高效的PI操作"
          }
        }
      }
    },
