    },
    "Insurgency_info_supp_s5" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powerful sentry guns deployed and corruption beyond stage 4 prevented"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强大的岗哨炮已部署，第四阶段之后的腐蚀已被阻止"
          }
        }
      }
    },
    "Insurgency_info_text" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corruption represents the measure of criminal activity in a star system while Suppression represents the degree of law enforcement control. When these attributes reach specific stages, various effects may be triggered. Insurgency events make use of these attributes and activities spawned by insurgencies can cause suppression or corruption values to change in response to capsuleer activity."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腐蚀属性代表的是恒星系中犯罪活动的猖狂程度，而镇压属性代表的是执法程度。当这两种属性达到特定阶段时，就会产生不同效果。叛乱活动会影响这两种属性，而叛乱引发的活动会导致镇压值或腐蚀值随着克隆飞行员活动而变化。"
          }
        }
      }
    },
