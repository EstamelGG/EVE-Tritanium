    "AllInOne_Calculator_Description_Text" : {
      "comment" : "功能描述",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyze what products can be produced entirely on a single planet within a selected system. This tool identifies complete production chains that don't require inter-planetary transport.\n\n• Shows all single-planet capable products\n• Groups results by product level (P1-P4)\n• Displays compatible planet types and availability"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分析在选定星系内可以完全在单个行星上生产的产品。此工具识别不需要行星间运输的完整生产链。\n\n• 显示所有单星球生产能力的产品\n• 按产品等级分组显示结果(P1-P4)\n• 显示兼容的行星类型和可用性"
          }
        }
      }
    },
    "AllInOne_Calculator_Description_Title" : {
      "comment" : "单球生产计算器",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All-in-One Production Calculator"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单球生产计算器"
          }
        }
      }
    },
