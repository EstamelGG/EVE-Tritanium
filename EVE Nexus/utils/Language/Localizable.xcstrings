    "AllInOne_SystemFinder_Description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find systems that can produce multiple PI products"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查找能够生产多种PI产品的星系"
          }
        }
      }
    },
    "AllInOne_SystemFinder_Description_Text" : {
      "comment" : "功能描述",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This tool helps you find systems that can support multiple PI products for single-planet production. Select your desired products, choose a region or sovereignty, then calculate to find the best systems.\n\n• Avoids conflicts where one planet is used for multiple products\n• Scores systems based on available planets and resource distribution\n• Prioritizes systems with multiple planets for each product type\n• Some products can not be processed in single planet"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此工具帮助您找到能够支持多种PI产品进行单星球生产（从P0到最终产品）的星系。选择您想要的产品，选择星域或主权，然后计算以找到最佳星系。\n\n• 避免一个行星被用于多个产品的冲突\n• 基于可用行星和资源分布对星系评分\n• 优先推荐每种产品类型都有多个可用行星的星系\n• 部分商品（如P4）无法在一颗星球上完成生产，不做展示"
          }
        }
      }
    },
