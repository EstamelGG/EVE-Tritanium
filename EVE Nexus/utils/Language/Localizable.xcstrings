      "comment" : "Skill queue footer hint",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculated from cached skill queue data fetched by the app; may differ from in-game real-time data."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基于应用拉取的技能队列数据计算，与游戏内实时数据可能不一致。"
